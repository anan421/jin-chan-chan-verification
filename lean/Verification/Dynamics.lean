-- Unbounded dynamics layer for the Jin Chan Chan replay page.
-- The finite layer (`Model.lean` / `Proofs.lean`, C1-C12) checks one
-- recorded trace with `native_decide`. This layer proves the
-- universal statement: ANY trajectory generated by the transition
-- relation preserves the invariants -- past rounds and future rounds
-- to 2030 alike. The 558-move trace is one instance of that theorem.
--
-- State machine (per player; `Model.lean`'s `Move` is referenced
-- unchanged):
-- - state `DState`: HP, gold, elimination, liability flag, current
--   rule version, date, season. Population and card holdings are
--   NOT in this state: `Move` carries no population or card-gain
--   input, so they stay in the finite layer (C6 pool checks) and in
--   the recorded move fields. The dynamics covers exactly what a
--   `Move` determines.
-- - step `applyMoveS`: one legal move. The rule version is a
--   parameter of the step (resolved at the move's date), never a
--   global constant; the recorded version is accepted per
--   `ruleVersionAccepted`, so a round whose span crosses a
--   rule-change day is a legal step. `applyMove` is the no-span
--   (`spans = []`) wrapper kept for `Prediction.lean`.
-- - `Reachable`: states reachable from an initial state by legal
--   steps. `invariant_reachable` is proved by induction on the
--   `Reachable` derivation; `invariant_run` by induction on the
--   move list. No `decide` over a finite list proves these.
--
-- Gold semantics (user-confirmed, 2026-11-21): gold is NEVER
-- clamped. A move's resulting gold may be negative if and only if
-- that move is flagged liability. The prototype clamped gold for
-- simplicity; this file does NOT carry that over. HP is clamped to
-- the rule version's bounds (the real rule, as in `Model.lean`).
--
-- Scope conditions, carried explicitly as hypotheses (checked by
-- `native_decide` for the real trace, via `dynRulesOk`):
-- (a) every rule has hpFloor <= hpCap;
-- (b) rule ids are unique in the table.
-- No `sorry`, no axioms beyond Lean's own.
import Verification.Model

namespace Jjc

/-- One player's dynamic state. `player` is carried so a step can
    check the move belongs to this trajectory. -/
structure DState where
  player : Nat
  hp : Int
  gold : Int
  elim : Bool
  liab : Bool
  rule : Nat
  date : Nat
  season : Nat
  deriving DecidableEq, Repr, Inhabited

/-- The dynamic invariant, as a `Bool` (so `native_decide` can check
    the instance and the induction can reason about it):
    HP inside the current rule version's bounds; gold >= 0 unless
    the last move was flagged liability; eliminated iff HP is 0;
    the current rule version is effective by now. -/
def dynInvariant (rules : List RuleVersion) (s : DState) : Bool :=
  match rules.find? fun x => x.id == s.rule with
  | none => false
  | some rv =>
    decide (rv.hpFloor ≤ s.hp) &&
    decide (s.hp ≤ rv.hpCap) &&
    (decide (0 ≤ s.gold) || s.liab) &&
    (if s.elim then s.hp == 0 else true) &&
    (if s.hp == 0 then s.elim else true) &&
    decide (rv.effectiveFrom ≤ s.date)

/-- HP clamp under one rule version. -/
theorem capHp_bounds {r : RuleVersion} {x : Int} (h : r.hpFloor ≤ r.hpCap) :
    r.hpFloor ≤ capHp r x ∧ capHp r x ≤ r.hpCap := by
  constructor <;> simp only [capHp] <;> omega

/-- From `(List.range n).all P = true`, read off `P i` for `i < n`. -/
theorem all_range_get {n : Nat} {P : Nat → Bool}
    (h : (List.range n).all P = true) {i : Nat} (hi : i < n) :
    P i = true :=
  List.all_eq_true.mp h i (List.mem_range.mpr hi)

/-- From `(l.all P) = true`, read off `P x` for `x ∈ l`. -/
theorem all_mem_get {α} {l : List α} {P : α → Bool}
    (h : l.all P = true) {x : α} (hx : x ∈ l) : P x = true :=
  List.all_eq_true.mp h x hx

/-- `(a == b) = true` means `a = b`. -/
theorem beq_eq {α} [BEq α] [LawfulBEq α] {a b : α} (h : (a == b) = true) :
    a = b :=
  beq_iff_eq.mp h

/-- `baseRuleAt` returns a rule from the table, in effect at the date. -/
theorem baseRuleAt_some {rules : List RuleVersion} {d : Nat}
    {r : RuleVersion} (h : baseRuleAt rules d = some r) :
    r ∈ rules ∧ r.targets = [] ∧ ruleInEffect r d = true := by
  have key : ∀ (l : List RuleVersion) (acc : Option RuleVersion),
      (l.foldl (fun a x => match a with
        | none => some x
        | some y => if x.effectiveFrom > y.effectiveFrom then some x
                    else some y) acc = some r) →
      (r ∈ l ∨ acc = some r) := by
    intro l acc
    induction l generalizing acc with
    | nil => simp
    | cons x xs ih =>
      intro hf
      simp only [List.foldl_cons] at hf
      cases acc with
      | none =>
        have := ih (some x) hf
        cases this with
        | inl hm => exact Or.inl (List.mem_cons_of_mem x hm)
        | inr hm => exact Or.inl (by simp [Option.some.inj hm])
      | some y =>
        by_cases hcmp : x.effectiveFrom > y.effectiveFrom
        · have := ih (some x) (by simp [hcmp] at hf; exact hf)
          cases this with
          | inl hm => exact Or.inl (List.mem_cons_of_mem x hm)
          | inr hm => exact Or.inl (by simp [Option.some.inj hm])
        · have := ih (some y) (by simp [hcmp] at hf; exact hf)
          cases this with
          | inl hm => exact Or.inl (List.mem_cons_of_mem x hm)
          | inr hm => exact Or.inr hm
  unfold baseRuleAt at h
  have hmem := key (rules.filter fun r =>
    r.targets.isEmpty && ruleInEffect r d) none h
  cases hmem with
  | inl hm =>
    have hm2 := List.mem_filter.mp hm
    refine ⟨hm2.1, ?_, ?_⟩
    · have := hm2.2
      simp [Bool.and_eq_true] at this
      exact this.1
    · have := hm2.2
      simp [Bool.and_eq_true] at this
      exact this.2
  | inr hm => simp at hm

/-- A rule found by id in a table with unique ids is the rule itself. -/
theorem find?_id_eq : ∀ {rules : List RuleVersion} {r : RuleVersion},
    (∀ r1 r2 : RuleVersion, r1 ∈ rules → r2 ∈ rules →
      r1.id = r2.id → r1 = r2) →
    r ∈ rules → rules.find? fun x => x.id == r.id = some r := by
  intro rules r
  induction rules with
  | nil => intro _ hmem; simp at hmem
  | cons x xs ih =>
    intro huniq hmem
    simp only [List.mem_cons] at hmem
    simp only [List.find?]
    cases hb : x.id == r.id with
    | true =>
      have hxeq : x.id = r.id := beq_eq hb
      have hxr : x = r := huniq x r List.mem_cons_self
        (by cases hmem with
           | inl h => rw [← h]; exact List.mem_cons_self
           | inr h => exact List.mem_cons_of_mem x h) hxeq
      subst hxr
      rfl
    | false =>
      have hmem' : r ∈ xs := by
        cases hmem with
        | inl h =>
          have hcontra : (x.id == r.id) = true := by simp [← h]
          simp [hb] at hcontra
        | inr h => exact h
      have ih' := ih (fun r1 r2 h1 h2 hid => huniq r1 r2
        (List.mem_cons_of_mem x h1) (List.mem_cons_of_mem x h2) hid) hmem'
      show List.find? (fun x => x.id == r.id) xs = some r
      exact ih'

/-- One legal move applied to a player's state, with the round-span
    table. Returns `none` when the move is illegal: it belongs to
    another player, the player is eliminated, no rule version is in
    effect at the move's date, the recorded rule version is not
    accepted (`ruleVersionAccepted`: the base rule in effect at the
    move's date, or a base rule whose window overlaps the round span
    -- e.g. S5 round 5 records RV-2026.2 for the 2026-11-18–19 span),
    the action kind is banned under the version in effect, or the
    resulting gold is negative without a liability flag.
    Gold is NEVER clamped. HP is clamped to the rule's bounds.
    `spans` is `(season, roundIdx, spanEnd)` per `traceRoundSpans`;
    `[]` means no round spans (the strict, pre-2026-11-21 reading). -/
def applyMoveS (rules : List RuleVersion)
    (spans : List (Nat × Nat × Nat)) (s : DState) (m : Move) :
    Option DState :=
  match baseRuleAt rules m.date with
  | none => none
  | some base =>
    if m.player == s.player && !s.elim &&
       ruleVersionAccepted rules spans m &&
       !(base.bannedKinds.contains m.actionKind) &&
       !((overlaysAt rules m.date m.player).any fun ov =>
         ov.bannedKinds.contains m.actionKind) &&
       (decide (0 ≤ s.gold + m.goldDelta) || m.liability) then
      let hp' := capHp base (s.hp + m.hpDelta)
      some { player := s.player, hp := hp',
             gold := s.gold + m.goldDelta,
             elim := s.elim || hp' == 0, liab := m.liability,
             rule := base.id, date := m.date, season := m.season }
    else none

/-- The no-span step, kept under the old name and arity: `applyMove`
    is `applyMoveS` with `spans = []`. `Prediction.lean` still calls
    this form; the span-aware checks and theorems use `applyMoveS`. -/
def applyMove (rules : List RuleVersion) (s : DState) (m : Move) :
    Option DState :=
  applyMoveS rules [] s m

/-- Run a whole list of moves (any length) from a state. -/
def run : List RuleVersion → List (Nat × Nat × Nat) → DState →
    List Move → Option DState
  | _, _, s, [] => some s
  | rules, spans, s, m :: ms =>
    match applyMoveS rules spans s m with
    | none => none
    | some s' => run rules spans s' ms

/-- All intermediate states of a run, or `none` if any step is illegal. -/
def runStates : List RuleVersion → List (Nat × Nat × Nat) → DState →
    List Move → Option (List DState)
  | _, _, _, [] => some []
  | rules, spans, s, m :: ms =>
    match applyMoveS rules spans s m with
    | none => none
    | some s' => (s' :: ·) <$> runStates rules spans s' ms

/-- States reachable from an initial state by legal steps. -/
inductive Reachable (rules : List RuleVersion)
    (spans : List (Nat × Nat × Nat)) (s0 : DState) :
    DState → Prop where
  | refl : Reachable rules spans s0 s0
  | step : ∀ {s s'}, Reachable rules spans s0 s →
      (∃ m, applyMoveS rules spans s m = some s') →
      Reachable rules spans s0 s'

/-- Well-formedness of a rule table, as one `Bool`: floor <= cap and
    unique ids. (No uniformity hypothesis is needed here: the state
    is per-player, so a rule change only ever re-bounds the acting
    player's HP, which `applyMove` clamps.) -/
def dynRulesOk (rules : List RuleVersion) : Bool :=
  rules.all (fun r => decide (r.hpFloor ≤ r.hpCap)) &&
  rules.all (fun r1 => rules.all (fun r2 =>
    if r1.id == r2.id then r1 == r2 else true))

theorem dynRulesOk_floor {rules : List RuleVersion}
    (h : dynRulesOk rules = true) :
    ∀ r ∈ rules, r.hpFloor ≤ r.hpCap := by
  intro r hr
  simp only [dynRulesOk, Bool.and_eq_true] at h
  have := all_mem_get h.1 hr
  exact decide_eq_true_eq.mp this

theorem dynRulesOk_uniq {rules : List RuleVersion}
    (h : dynRulesOk rules = true) :
    ∀ r1 r2 : RuleVersion, r1 ∈ rules → r2 ∈ rules →
      r1.id = r2.id → r1 = r2 := by
  intro r1 r2 hr1 hr2 hid
  simp only [dynRulesOk, Bool.and_eq_true] at h
  have h1 := all_mem_get h.2 hr1
  have h2 := all_mem_get h1 hr2
  simp only [hid, beq_self_eq_true, ite_true] at h2
  exact beq_eq h2

/-- Per-player instance check: every player's move list runs legally
    from their initial state, and every visited state satisfies the
    invariant. -/
def checkDynamics (rules : List RuleVersion)
    (spans : List (Nat × Nat × Nat)) (inits : List DState)
    (moves : List Move) : Bool :=
  (List.range inits.length).all fun i =>
    let init := inits.getD i default
    match runStates rules spans init (moves.filter fun m => m.player == i) with
    | none => false
    | some states => states.all (dynInvariant rules)

/-- One step preserves the invariant. The rule version is resolved
    at the move's date; HP is re-bounded by that version; gold is
    carried unclamped (negative only with a liability flag). The
    recorded version is checked with `ruleVersionAccepted`, so a
    span-crossing round (e.g. S5 round 5) is a legal step. -/
theorem invariant_applyS (rules : List RuleVersion)
    (spans : List (Nat × Nat × Nat))
    (hfloor : ∀ r ∈ rules, r.hpFloor ≤ r.hpCap)
    (huniq : ∀ r1 r2 : RuleVersion, r1 ∈ rules → r2 ∈ rules →
      r1.id = r2.id → r1 = r2) :
    ∀ (s : DState) (m : Move) (s' : DState),
    dynInvariant rules s = true → applyMoveS rules spans s m = some s' →
    dynInvariant rules s' = true := by
  intro s m s' _hinv hstep
  unfold applyMoveS at hstep
  cases hbase : baseRuleAt rules m.date with
  | none => simp [hbase] at hstep
  | some base =>
    simp only [hbase] at hstep
    split at hstep
    · rename_i hcond
      injection hstep with hseq
      subst hseq
      simp only [Bool.and_eq_true] at hcond
      have helim : (!s.elim) = true := hcond.1.1.1.1.2
      have hgold : (decide (0 ≤ s.gold + m.goldDelta) || m.liability)
          = true := hcond.2
      have helim' : s.elim = false := by simpa using helim
      have hmem : base ∈ rules := (baseRuleAt_some hbase).1
      have hfind : rules.find? fun x => x.id == base.id = some base :=
        find?_id_eq huniq hmem
      have heff : base.effectiveFrom ≤ m.date := by
        have h := (baseRuleAt_some hbase).2.2
        simp only [ruleInEffect, Bool.and_eq_true,
          decide_eq_true_eq] at h
        exact h.1
      have hbounds := capHp_bounds (x := s.hp + m.hpDelta)
        (hfloor base hmem)
      simp only [dynInvariant, hfind, Bool.and_eq_true,
        decide_eq_true_eq]
      refine ⟨⟨⟨⟨⟨?_, ?_⟩, ?_⟩, ?_⟩, ?_⟩, ?_⟩
      · exact hbounds.1
      · exact hbounds.2
      · exact hgold
      · simp only [helim', Bool.false_or]
        by_cases hb : (capHp base (s.hp + m.hpDelta) == 0) = true <;>
          simp [hb]
      · simp only [helim', Bool.false_or]
        by_cases hb : (capHp base (s.hp + m.hpDelta) == 0) = true <;>
          simp [hb]
      · exact heff
    · simp at hstep

/-- The no-span instance of `invariant_applyS`, kept under the old
    name and arity for `Prediction.lean`: `applyMove` is `applyMoveS`
    with `spans = []`, so this is `invariant_applyS rules []`. -/
theorem invariant_apply (rules : List RuleVersion)
    (hfloor : ∀ r ∈ rules, r.hpFloor ≤ r.hpCap)
    (huniq : ∀ r1 r2 : RuleVersion, r1 ∈ rules → r2 ∈ rules →
      r1.id = r2.id → r1 = r2) :
    ∀ (s : DState) (m : Move) (s' : DState),
    dynInvariant rules s = true → applyMove rules s m = some s' →
    dynInvariant rules s' = true :=
  fun s m s' hinv hstep =>
    invariant_applyS rules [] hfloor huniq s m s' hinv hstep

/-- The unbounded theorem: the invariant holds after ANY list of
    moves, of any length -- past rounds and future rounds to 2030
    alike. Proved by induction on the list, not by `native_decide`
    over one recorded trace. -/
theorem invariant_run (rules : List RuleVersion)
    (spans : List (Nat × Nat × Nat))
    (hfloor : ∀ r ∈ rules, r.hpFloor ≤ r.hpCap)
    (huniq : ∀ r1 r2 : RuleVersion, r1 ∈ rules → r2 ∈ rules →
      r1.id = r2.id → r1 = r2) :
    ∀ (ms : List Move) (s s' : DState),
    dynInvariant rules s = true → run rules spans s ms = some s' →
    dynInvariant rules s' = true := by
  intro ms
  induction ms with
  | nil =>
    intro s s' hinv hrun
    simp only [run, Option.some.injEq] at hrun
    subst hrun
    exact hinv
  | cons m ms ih =>
    intro s s' hinv hrun
    simp only [run] at hrun
    cases hstep : applyMoveS rules spans s m with
    | none => simp [hstep] at hrun
    | some s1 =>
      simp only [hstep] at hrun
      exact ih s1 s' (invariant_applyS rules spans hfloor huniq s m s1 hinv hstep)
        hrun

/-- Every intermediate state of any run satisfies the invariant. -/
theorem invariant_runStates (rules : List RuleVersion)
    (spans : List (Nat × Nat × Nat))
    (hfloor : ∀ r ∈ rules, r.hpFloor ≤ r.hpCap)
    (huniq : ∀ r1 r2 : RuleVersion, r1 ∈ rules → r2 ∈ rules →
      r1.id = r2.id → r1 = r2) :
    ∀ (ms : List Move) (s : DState) (states : List DState),
    dynInvariant rules s = true → runStates rules spans s ms = some states →
    states.all (dynInvariant rules) = true := by
  intro ms
  induction ms with
  | nil =>
    intro s states hinv hrun
    simp only [runStates, Option.some.injEq] at hrun
    subst hrun
    rfl
  | cons m ms ih =>
    intro s states hinv hrun
    simp only [runStates] at hrun
    cases hstep : applyMoveS rules spans s m with
    | none => simp [hstep] at hrun
    | some s1 =>
      simp only [hstep] at hrun
      cases hrest : runStates rules spans s1 ms with
      | none => simp [hrest] at hrun
      | some rest =>
        simp [hrest] at hrun
        subst hrun
        simp only [List.all_cons, Bool.and_eq_true]
        exact ⟨invariant_applyS rules spans hfloor huniq s m s1 hinv hstep,
               ih s1 rest
                 (invariant_applyS rules spans hfloor huniq s m s1 hinv hstep)
                 hrest⟩

/-- The same invariant, for the inductively defined reachable
    states: any state reachable from an invariant initial state
    satisfies the invariant. -/
theorem invariant_reachable (rules : List RuleVersion)
    (spans : List (Nat × Nat × Nat))
    (hfloor : ∀ r ∈ rules, r.hpFloor ≤ r.hpCap)
    (huniq : ∀ r1 r2 : RuleVersion, r1 ∈ rules → r2 ∈ rules →
      r1.id = r2.id → r1 = r2) :
    ∀ (s0 s' : DState),
    dynInvariant rules s0 = true → Reachable rules spans s0 s' →
    dynInvariant rules s' = true := by
  intro s0 s' hinv hreach
  induction hreach with
  | refl => exact hinv
  | step hreach hex ih =>
    exact hex.elim (fun m hm =>
      invariant_applyS rules spans hfloor huniq _ m _ ih hm)

/-- Temporal property: an eliminated player has no outgoing move
    (death is terminal). -/
theorem elim_no_move (rules : List RuleVersion)
    (spans : List (Nat × Nat × Nat)) (s : DState) (m : Move) :
    s.elim = true → applyMoveS rules spans s m = none := by
  intro helim
  unfold applyMoveS
  cases hbase : baseRuleAt rules m.date with
  | none => simp
  | some base => simp [helim]

/-- Temporal property, trajectory level: in a successful run, an
    eliminated state can only be the last one -- after death there
    is no further state. -/
theorem elim_last (rules : List RuleVersion)
    (spans : List (Nat × Nat × Nat)) :
    ∀ (ms : List Move) (s : DState) (states : List DState),
    runStates rules spans s ms = some states →
    ∀ s' ∈ states, s'.elim = true → states.getLast? = some s' := by
  intro ms
  induction ms with
  | nil =>
    intro s states hrun s' hmem _helim
    simp only [runStates, Option.some.injEq] at hrun
    subst hrun
    simp at hmem
  | cons m ms ih =>
    intro s states hrun s' hmem helim
    simp only [runStates] at hrun
    cases hstep : applyMoveS rules spans s m with
    | none => simp [hstep] at hrun
    | some s1 =>
      simp only [hstep] at hrun
      cases hrest : runStates rules spans s1 ms with
      | none => simp [hrest] at hrun
      | some rest =>
        simp [hrest] at hrun
        subst hrun
        simp only [List.mem_cons] at hmem
        cases hmem with
        | inl heq =>
          subst s'
          cases hms : ms with
          | nil =>
            rw [hms] at hrest
            simp only [runStates, Option.some.injEq] at hrest
            subst hrest
            rfl
          | cons a ms' =>
            have hnone : runStates rules spans s1 (a :: ms') = none := by
              simp only [runStates, elim_no_move rules spans s1 a helim]
            rw [hms] at hrest
            rw [hnone] at hrest
            simp at hrest
        | inr hmem' =>
          have hlast := ih s1 rest hrest s' hmem' helim
          cases hrest2 : rest with
          | nil =>
            subst hrest2
            simp at hmem'
          | cons b rb =>
            rw [hrest2] at hlast
            exact hlast

/-- Gold semantics as a theorem: a step may leave gold negative
    only when that move is flagged liability. -/
theorem step_gold_liability (rules : List RuleVersion)
    (spans : List (Nat × Nat × Nat)) (s : DState)
    (m : Move) (s' : DState) (hstep : applyMoveS rules spans s m = some s') :
    s'.gold < 0 → m.liability = true := by
  unfold applyMoveS at hstep
  cases hbase : baseRuleAt rules m.date with
  | none => simp [hbase] at hstep
  | some base =>
    simp only [hbase] at hstep
    split at hstep
    · rename_i hcond
      injection hstep with hseq
      subst hseq
      simp only [Bool.and_eq_true] at hcond
      have hgold : (decide (0 ≤ s.gold + m.goldDelta) || m.liability)
          = true := hcond.2
      intro hneg
      have hdec : decide (0 ≤ s.gold + m.goldDelta) = false := by
        rw [decide_eq_false]
        have hgold' : s.gold + m.goldDelta < 0 := hneg
        omega
      simp [hdec] at hgold
      exact hgold
    · simp at hstep

/-- Running a list with one move appended is the same as running the
    list and then taking that move. -/
theorem run_append_single (rules : List RuleVersion)
    (spans : List (Nat × Nat × Nat)) (s : DState)
    (ms : List Move) (m : Move) :
    run rules spans s (ms ++ [m]) =
      (run rules spans s ms).bind fun s' => applyMoveS rules spans s' m := by
  induction ms generalizing s with
  | nil =>
    simp only [List.nil_append, run, Option.bind]
    cases hstep : applyMoveS rules spans s m <;> simp
  | cons a ms ih =>
    simp only [List.cons_append, run]
    cases hstep : applyMoveS rules spans s a with
    | none => simp
    | some s1 =>
      exact ih s1

/-- Reachability is transitive. -/
theorem reachable_trans (rules : List RuleVersion)
    (spans : List (Nat × Nat × Nat)) (s0 s1 s2 : DState) :
    Reachable rules spans s0 s1 → Reachable rules spans s1 s2 →
    Reachable rules spans s0 s2 := by
  intro h1 h2
  induction h2 with
  | refl => exact h1
  | step _ hex ih =>
    exact Reachable.step ih (hex.elim (fun m hm => ⟨m, hm⟩))

/-- Reachable states are exactly the endpoints of move lists. -/
theorem reachable_iff_run (rules : List RuleVersion)
    (spans : List (Nat × Nat × Nat)) (s0 s' : DState) :
    Reachable rules spans s0 s' ↔ ∃ ms, run rules spans s0 ms = some s' := by
  constructor
  · intro hreach
    induction hreach with
    | refl => exact ⟨[], rfl⟩
    | step hreach hex ih =>
      obtain ⟨ms, hms⟩ := ih
      exact hex.elim (fun m hm =>
        ⟨ms ++ [m], by simp [run_append_single, hms, hm]⟩)
  · rintro ⟨ms, hms⟩
    induction ms generalizing s0 with
    | nil =>
      simp only [run, Option.some.injEq] at hms
      subst hms
      exact Reachable.refl
    | cons a ms ih =>
      simp only [run] at hms
      cases hstep : applyMoveS rules spans s0 a with
      | none => simp [hstep] at hms
      | some s1 =>
        simp only [hstep] at hms
        exact reachable_trans rules spans s0 s1 s'
          (Reachable.step Reachable.refl ⟨a, hstep⟩) (ih s1 hms)

end Jjc
